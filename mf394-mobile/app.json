{
  "expo": {
    "name": "UmmYou",
    "slug": "ummyoumobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "sdkVersion": "54.0.0",
    "icon": "./assets/ios_icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f3ef"
    },
    "scheme": "ummyou",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.ummyou.ios",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ummyou.android",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android_icon_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/ios_icon.png"
    },
    "plugins": [
      "expo-image-picker",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 0
          },
          "androidIntentFilters": [
            "image/*"
          ],
          "androidMultiIntentFilters": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4cdef0df-ccfd-4ec8-bf9c-7431997e0e10"
      }
    },
    "owner": "pjobin"
  }
}
